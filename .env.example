# Plantilla de los valores que necesita el entorno local.
#
#   cp .env.example .env
#
# Docker Compose lee .env automaticamente. El fichero .env NO se versiona: es donde cada uno pone
# sus valores, y evita que una credencial real acabe en el repositorio por haberla escrito donde
# antes habia un ejemplo. Todos estos valores son desechables y solo valen para este stack local.

# --- PostgreSQL --------------------------------------------------------------------------------
# Un unico servidor con las cinco bases. Las crea postgres/init/01-databases.sql en la PRIMERA
# arrancada; cambiar cualquiera de estos valores despues exige 'docker compose down -v'.
POSTGRES_PORT=5432
# Base y superusuario del contenedor. Ninguna aplicacion se conecta con este usuario.
POSTGRES_DB=mto
POSTGRES_USER=mto
POSTGRES_PASSWORD=mto

MTO_CONFIGURATION_DB=mto_configuration_db
MTO_CONFIGURATION_USER=mto_configuration_user
MTO_CONFIGURATION_PASSWORD=mto_configuration_password
MTO_CONFIGURATION_SCHEMA=mto_configuration

MTO_STOCK_DB=mto_stock
MTO_STOCK_USER=mto_stock_user
MTO_STOCK_PASSWORD=mto_stock_password

MTO_MAINTENANCE_DB=mto_maintenance
MTO_MAINTENANCE_USER=mto_maintenance_user
MTO_MAINTENANCE_PASSWORD=mto_maintenance_password

MTO_NOTIFICATION_DB=mto_notification
MTO_NOTIFICATION_USER=mto_notification_user
MTO_NOTIFICATION_PASSWORD=mto_notification_password

MTO_FIELD_DB=mto_field
MTO_FIELD_USER=mto_field_user
MTO_FIELD_PASSWORD=mto_field_password

# --- Redis -------------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_PASSWORD=mto_redis_password
REDIS_MAXMEMORY=256mb

# --- RabbitMQ ----------------------------------------------------------------------------------
# UN SOLO broker para las aplicaciones que lo usan, y todas con el mismo usuario. Cuando cada repositorio
# levantaba el suyo, mto-configuration publicaba en uno y mto-stock escuchaba en otro: los mensajes
# no llegaban y nada daba error.
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=mto
RABBITMQ_PASSWORD=mto
RABBITMQ_VHOST=/

# Firma de los mensajes. El MISMO valor lo usan todas las aplicaciones que publican o consumen: con secreto
# la firma es HMAC-SHA256 y protege de manipulacion, sin el es un SHA-256 que solo detecta
# corrupcion. Vacio por defecto porque repartir un secreto es una decision de explotacion.
MESSAGING_SIGNATURE_SECRET=
# DISABLED | OPTIONAL | REQUIRED. Pasar a REQUIRED solo cuando todas compartan el secreto: antes
# de eso, REQUIRED manda a la DLQ todos los mensajes validos.
MESSAGING_SIGNATURE_MODE=OPTIONAL

# --- Keycloak ----------------------------------------------------------------------------------
# El realm se alcanza por el HOST con un nombre estable, no por el nombre del servicio de compose:
# el 'iss' de los tokens es esta URL, y tiene que resolverse igual desde dentro de compose y desde
# un servicio arrancado en el IDE. auth.mto.local lo resuelven los extra_hosts de cada aplicacion;
# en el host hace falta la entrada correspondiente en /etc/hosts (vease README.md).
KEYCLOAK_PORT=8082
KEYCLOAK_MANAGEMENT_PORT=9000
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
KEYCLOAK_ISSUER_URI=http://auth.mto.local:8082/realms/mto

# Secreto de la cuenta de servicio con la que mto-configuration llama a otros servicios. Tiene que
# coincidir con el campo "secret" de mto-configuration-svc en
# mto-configuration/keycloak/mto-configuration-dev.json. En un entorno desplegado lo genera Keycloak
# y se lee de su consola.
KEYCLOAK_SERVICE_CLIENT_SECRET=mto-configuration-svc-secret
# Lo mismo para la cuenta con la que mto-maintenance llama a mto-stock. Tiene que coincidir con el
# campo "secret" de mto-maintenance-svc en mto-maintenance/keycloak/mto-maintenance-dev.json. Los
# roles stock-read y stock-write que necesita se los concede apply-partials.sh.
MTO_MAINTENANCE_SERVICE_CLIENT_SECRET=mto-maintenance-svc-secret
# Y para la cuenta con la que mto-users administra el realm por la Admin API. Tiene que coincidir
# con el campo "secret" de mto-users-svc en mto-users/keycloak/mto-users-dev.json. Los seis roles de
# realm-management que necesita se los concede apply-partials.sh. Nada del realm master.
MTO_USERS_SERVICE_CLIENT_SECRET=mto-users-svc-secret
# Cliente de login del backoffice web (mto-backoffice-dev.json de su repositorio).
MTO_BACKOFFICE_CLIENT_SECRET=mto-backoffice-secret
# Y para la cuenta con la que mto-notification lee los eventos de acceso y de administracion del realm
# por la Admin API. Tiene que coincidir con el campo "secret" de mto-notification-svc en
# mto-notification/keycloak/mto-notification-dev.json. Sus roles de realm-management (view-events y los
# de directorio) se los concede apply-partials.sh, que ademas activa los eventos del realm.
MTO_NOTIFICATION_SERVICE_CLIENT_SECRET=mto-notification-svc-secret
# Y para la cuenta con la que mto-field llama a mto-maintenance (turnos, inicio y fin de tareas).
# Tiene que coincidir con el campo "secret" de mto-field-svc en mto-field/keycloak/mto-field-dev.json.
# Los roles maintenance-read y maintenance-write que necesita se los concede apply-partials.sh.
MTO_FIELD_SERVICE_CLIENT_SECRET=mto-field-svc-secret

# --- Correo ------------------------------------------------------------------------------------
# Mailpit recibe todo el correo del entorno local y lo ensena en http://localhost:8025: los avisos
# urgentes de mto-notification y el correo de acciones de Keycloak (contrasena temporal, verificar
# email), que sin un SMTP fallaba. No reenvia nada fuera.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Observabilidad ----------------------------------------------------------------------------
# Un solo colector para todos los servicios: asi una traza que empieza en el gateway y termina en
# mto-stock, saltando por la cola de RabbitMQ, se ve entera en un mismo sitio.
JAEGER_UI_PORT=16686
JAEGER_OTLP_HTTP_PORT=4318
JAEGER_OTLP_GRPC_PORT=4317
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel.mto.local:4318/v1/traces

# --- Aplicaciones ------------------------------------------------------------------------------
# Imagenes publicadas en GHCR por el CI de cada repositorio. Para probar un cambio sin publicar,
# construyase la imagen en el repositorio correspondiente y pongase aqui su etiqueta.
MTO_CONFIGURATION_TAG=latest
MTO_STOCK_TAG=latest
MTO_GATEWAY_TAG=latest
MTO_MAINTENANCE_TAG=latest
MTO_USERS_TAG=latest
MTO_BACKOFFICE_TAG=latest
MTO_NOTIFICATION_TAG=latest
MTO_FIELD_TAG=latest
MTO_FRONTEND_TAG=latest

MTO_CONFIGURATION_PORT=8081
MTO_STOCK_PORT=8080
MTO_GATEWAY_PORT=8090
# 8083: el 8082 es Keycloak.
MTO_MAINTENANCE_PORT=8083
MTO_USERS_PORT=8084
MTO_BACKOFFICE_PORT=8085
MTO_NOTIFICATION_PORT=8086
# mto-field publica dos puertos: Actuator por HTTP y la API por gRPC, a la que los clientes llegan
# directamente (el gateway no hace de proxy gRPC). 8087 es el siguiente libre tras mto-notification.
MTO_FIELD_PORT=8087
MTO_FIELD_GRPC_PORT=9094
# La segunda replica de mto-field (perfil field-cluster): las dos comparten base y broker.
MTO_FIELD_2_PORT=8088
MTO_FIELD_2_GRPC_PORT=9095
# 4200: el redirect URI del cliente mto-frontend en el realm. La SPA llama a /api por su mismo
# origen, asi que no necesita los origenes CORS de abajo.
MTO_FRONTEND_PORT=4200
# Las dos aplicaciones web, tal como las ve el navegador: 'Abrir en el backoffice' de la SPA y
# 'Abrir en mto-frontend' del backoffice llevan a la misma pantalla en la otra.
MTO_BACKOFFICE_PUBLIC_URL=http://localhost:8085
MTO_FRONTEND_PUBLIC_URL=http://localhost:4200

MTO_STOCK_SPRING_PROFILE=prod
MTO_MAINTENANCE_SPRING_PROFILE=prod
MTO_USERS_SPRING_PROFILE=prod
MTO_NOTIFICATION_SPRING_PROFILE=prod
MTO_FIELD_SPRING_PROFILE=prod
# El cliente de mto-maintenance de mto-field: true lee los turnos de mto-maintenance y le cuenta las
# tareas; false inventa los turnos (cualquier id vale) y deja las tareas pendientes.
MTO_FIELD_MAINTENANCE_ENABLED=true
# El bus de replicas de mto-field sobre el RabbitMQ de la plataforma; con false cada replica se
# entera de las demas solo por la base (mas despacio, nunca mal).
MTO_FIELD_RABBITMQ_ENABLED=true
APP_SECURITY_EXPOSE_API_DOCS=true
# Los origenes que admite el CORS del gateway, el unico del dominio: los servicios no tienen CORS
# propio y el gateway les quita Origin antes de llamar.
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5173

# Destinos del gateway (y de mto-maintenance hacia stock). Por nombre de servicio porque todos
# comparten red. Al parar una aplicacion para arrancarla desde el IDE, apuntese la suya al host:
#   MTO_STOCK_URL=http://host.docker.internal:8080
MTO_CONFIGURATION_URL=http://configuration:8080
MTO_STOCK_URL=http://stock:8080
MTO_MAINTENANCE_URL=http://maintenance:8080
MTO_USERS_URL=http://users:8080
MTO_NOTIFICATION_URL=http://notification:8080
# La Admin API de Keycloak, para mto-users. El mismo host que el emisor de los tokens, sin realm.
KEYCLOAK_AUTH_SERVER_URL=http://auth.mto.local:8082
